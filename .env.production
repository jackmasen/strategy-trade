# ==========================================
# AI策略交易系统 v1.2.5 生产环境配置
# ==========================================
# 部署到服务器时用此文件替换 .env
# 标记 [改] 的地方需要你填实际值

# ---------- 应用 ----------
APP_NAME=TradingStrategySystem
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=3Tm9Tkj1dShjjFoiCEIdaI1I55eKqLBWtO6V8cZsMUelAFV2ha4V22TaP_ZO6Vd5
API_PREFIX=/api/v1

# ---------- 服务 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------- MySQL [改] ----------
# 把 your_password 改为你的MySQL实际密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trading_user
DB_PASSWORD=your_password
DB_NAME=trading_system
DB_CHARSET=utf8mb4
# 生产环境不使用SQLite，保持留空
# DB_SQLITE_FALLBACK=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DB_CELERY=1

# ---------- Celery ----------
CELERY_ENABLED=true

# ---------- CORS [改] ----------
# 改为你的实际域名，逗号分隔
CORS_ALLOW_ORIGINS=https://aicl.tgjsbot.kdns.fr,https://xwy.tgjsbot.kdns.fr

# ---------- JWT ----------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 币安 [改] ----------
# 生产环境改为 false 使用真实交易，true=测试网
BINANCE_TESTNET=true
BINANCE_BASE_URL=https://testnet.binancefuture.com

# ---------- OKX [改] ----------
OKX_TESTNET=true
OKX_BASE_URL=https://www.okx.com

# ---------- AI [改] ----------
# 填入你的AI API Key则启用AI分析，留空则自动降级到规则引擎
AI_PROVIDER=custom
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL_NAME=gpt-4o

# ---------- 新闻源 [改] ----------
# 全部可选，留空则跳过对应源
CRYPTOPANIC_TOKEN=
FRED_API_KEY=
EIA_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSDATA_API_KEY=
MINIFLUX_URL=
MINIFLUX_API_KEY=
MINIFLUX_USERNAME=
MINIFLUX_PASSWORD=

# ---------- 代理池 ----------
PROXY_ENABLED=false
PROXY_HTTP_LIST=
PROXY_PROVIDER_URL=

# ---------- 告警 [改] ----------
# 钉钉/飞书 通知，可选
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ---------- GitHub ----------
GITHUB_REPO=jackmasen/strategy-trade
GITHUB_TOKEN=

# ---------- 风控默认 ----------
DEFAULT_MAX_SINGLE_DRAWDOWN=2.0
DEFAULT_DAILY_MAX_LOSS=5.0
DEFAULT_MAX_POSITION_COUNT=3
DEFAULT_TOTAL_POSITION_RATIO=50.0
DEFAULT_SCORE_THRESHOLD=5.0
DEFAULT_LEVERAGE_MIN=3
DEFAULT_LEVERAGE_MAX=10
