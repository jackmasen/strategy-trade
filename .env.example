# ========== 基础配置 ==========
APP_NAME=TradingStrategySystem
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change_this_to_your_secret_key_please_use_random_string
API_PREFIX=/api/v1

# ========== 服务端口 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ========== MySQL 数据库 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trading_user
DB_PASSWORD=your_mysql_password
DB_NAME=trading_system
DB_CHARSET=utf8mb4
# 本地无 MySQL 时可填 sqlite 绝对路径快速跑通（单机演示/离线/临时运营兜底，生产强制 MySQL）
# 示例（Windows）：DB_SQLITE_FALLBACK=sqlite:///C:/Users/AI/trading_system.db
# 示例（Linux）：  DB_SQLITE_FALLBACK=sqlite:////www/wwwroot/strategy-trade/trading_system.db
DB_SQLITE_FALLBACK=

# ========== Redis 缓存/队列 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DB_CELERY=1

# ========== JWT 认证 ==========
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 币安交易所（主账号，用于创建子账号） ==========
BINANCE_MAIN_API_KEY=
BINANCE_MAIN_API_SECRET=
BINANCE_TESTNET=true
BINANCE_BASE_URL=https://testnet.binancefuture.com

# ========== OKX 交易所（主账号） ==========
OKX_MAIN_API_KEY=
OKX_MAIN_API_SECRET=
OKX_MAIN_PASSPHRASE=
OKX_TESTNET=true
OKX_BASE_URL=https://www.okx.com

# ========== AI 接口配置 ==========
AI_PROVIDER=custom
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL_NAME=gpt-4o

# ========== 新闻数据源 ==========
# 以下都是免费公开源（RSS/官网），不填也能用；填了可获得更精确的官方结构化数据
NEWSAPI_KEY=
CRYPTOPANIC_TOKEN=
# FRED：美联储圣路易斯分行开放 API（CPE/NFP/失业率/美债收益率等，直接影响 BTC / 黄金 / 石油）
# 免费申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# EIA：美国能源信息署开放 API（每周 WTI 原油/汽油库存、原油产量 — WTI 日内最高级别数据发布）
# 免费申请：https://www.eia.gov/opendata/
EIA_API_KEY=

# ========== 代理池（可选，解决美国新闻源403/空RSS问题；全部留空=直连，系统会自动降级） ==========
# 方式 1 最快：直接写固定代理，逗号分隔。格式 http://[user:pass@]host:port 或 socks5://...
PROXY_HTTP_LIST=
# 方式 2：从 URL 拉代理（返回一行一个或 JSON 数组），留空跳过
PROXY_PROVIDER_URL=
# 代理拉取间隔（分钟，默认 20）
PROXY_REFRESH_MINUTES=20
# 代理默认 TTL（分钟，默认 25 — 从分配时刻算，到期不给新任务；提前 1 分钟开始不分配）
PROXY_DEFAULT_TTL_MINUTES=25
# 代理获取超时（秒，默认 8 — 拿不到就自动降级直连，避免卡死）
PROXY_FETCH_TIMEOUT_SECONDS=8
# 总开关：false 时所有请求直连
PROXY_ENABLED=true

# ========== 告警推送 ==========
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ========== 风控默认参数 ==========
DEFAULT_MAX_SINGLE_DRAWDOWN=2.0
DEFAULT_DAILY_MAX_LOSS=5.0
DEFAULT_MAX_POSITION_COUNT=3
DEFAULT_TOTAL_POSITION_RATIO=50.0
DEFAULT_SCORE_THRESHOLD=5.0
DEFAULT_LEVERAGE_MIN=3
DEFAULT_LEVERAGE_MAX=10
